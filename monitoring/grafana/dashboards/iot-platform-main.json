{
  "title": "IoT Platform 可观测大盘 (V2-B)",
  "uid": "iot-platform-main",
  "schemaVersion": 39,
  "version": 2,
  "editable": true,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "browser",
  "tags": ["iot-platform"],
  "templating": {
    "list": [
      {
        "name": "uri",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
        "definition": "label_values(http_server_requests_seconds_count, uri)",
        "query": {
          "query": "label_values(http_server_requests_seconds_count, uri)",
          "refId": "StandardVariableQuery"
        },
        "label": "接口URI",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "sort": 1,
        "hide": 0
      }
    ]
  },
  "annotations": { "list": [] },
  "panels": [
    {
      "type": "row",
      "title": "运行概览",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 100,
      "type": "stat",
      "title": "活跃告警",
      "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "targets": [{ "refId": "A", "expr": "count(ALERTS{alertstate=\"firing\"})", "editorMode": "code", "legendFormat": "firing" }],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 2 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 101,
      "type": "stat",
      "title": "抓取目标健康 (UP)",
      "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "targets": [{ "refId": "A", "expr": "sum(up)", "editorMode": "code", "legendFormat": "up" }],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 2,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1.5 } ] }
        },
        "overrides": []
      }
    },
    {
      "id": 102,
      "type": "stat",
      "title": "在线设备连接数 (EMQX)",
      "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "targets": [{ "refId": "A", "expr": "emqx_connections_count", "editorMode": "code", "legendFormat": "connections" }],
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "palette-classic" } },
        "overrides": []
      }
    },
    {
      "id": 103,
      "type": "stat",
      "title": "接口 QPS (选中URI)",
      "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "targets": [{ "refId": "A", "expr": "sum(rate(http_server_requests_seconds_count{uri=~\"$uri\"}[$__rate_interval]))", "editorMode": "code", "legendFormat": "rps" }],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "color": { "mode": "palette-classic" } },
        "overrides": []
      }
    },
    {
      "type": "row",
      "title": "JVM 与接口",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 1,
      "type": "stat",
      "title": "JVM 堆内存",
      "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
      "gridPos": { "h": 7, "w": 6, "x": 0, "y": 6 },
      "targets": [{ "refId": "A", "expr": "max(jvm_memory_used_bytes{area=\"heap\"})", "editorMode": "code", "legendFormat": "heap-bytes" }],
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] }
    },
    {
      "id": 104,
      "type": "stat",
      "title": "JVM 活跃线程数",
      "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
      "gridPos": { "h": 7, "w": 6, "x": 6, "y": 6 },
      "targets": [{ "refId": "A", "expr": "jvm_threads_live_threads", "editorMode": "code", "legendFormat": "threads" }],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "id": 105,
      "type": "stat",
      "title": "JVM GC 暂停速率",
      "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
      "gridPos": { "h": 7, "w": 6, "x": 12, "y": 6 },
      "targets": [{ "refId": "A", "expr": "sum(rate(jvm_gc_pause_seconds_sum[$__rate_interval]))", "editorMode": "code", "legendFormat": "gc-pause-sec/s" }],
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 3 }, "overrides": [] }
    },
    {
      "id": 106,
      "type": "gauge",
      "title": "遥测线程池队列水位 (容量 5000)",
      "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
      "gridPos": { "h": 7, "w": 6, "x": 18, "y": 6 },
      "targets": [{ "refId": "A", "expr": "iot_telemetry_queue_pending", "editorMode": "code", "legendFormat": "pending" }],
      "fieldConfig": {
        "defaults": {
          "unit": "short", "min": 0, "max": 5000,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 4000 }, { "color": "red", "value": 4500 } ] }
        },
        "overrides": []
      }
    },
    {
      "id": 107,
      "type": "timeseries",
      "title": "接口 QPS by URI",
      "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "targets": [{ "refId": "A", "expr": "sum(rate(http_server_requests_seconds_count{uri=~\"$uri\"}[$__rate_interval])) by (uri)", "editorMode": "code", "legendFormat": "{{uri}}" }],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 10 } },
        "overrides": []
      }
    },
    {
      "id": 108,
      "type": "timeseries",
      "title": "接口耗时 P95 by URI",
      "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 },
      "targets": [{ "refId": "A", "expr": "histogram_quantile(0.95, sum by (uri, le) (rate(http_server_requests_seconds_bucket{uri=~\"$uri\"}[$__rate_interval])))", "editorMode": "code", "legendFormat": "{{uri}}" }],
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10 } },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "遥测上报→入库 链路耗时 (P95/P99)",
      "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 21 },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95, sum(rate(iot_telemetry_process_duration_seconds_bucket[$__rate_interval])) by (le))", "editorMode": "code", "legendFormat": "P95" },
        { "refId": "B", "expr": "histogram_quantile(0.99, sum(rate(iot_telemetry_process_duration_seconds_bucket[$__rate_interval])) by (le))", "editorMode": "code", "legendFormat": "P99" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10 } },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "遥测处理失败率",
      "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 21 },
      "targets": [{ "refId": "A", "expr": "sum(rate(iot_telemetry_process_failures_total[$__rate_interval]))", "editorMode": "code", "legendFormat": "failures/s" }],
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10 } },
        "overrides": []
      }
    },
    {
      "type": "row",
      "title": "EMQX 接入层",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 29 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 109,
      "type": "timeseries",
      "title": "EMQX 在线连接数",
      "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 30 },
      "targets": [
        { "refId": "A", "expr": "emqx_connections_count", "editorMode": "code", "legendFormat": "live" },
        { "refId": "B", "expr": "emqx_live_connections_count", "editorMode": "code", "legendFormat": "alive" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10 } },
        "overrides": []
      }
    },
    {
      "id": 110,
      "type": "timeseries",
      "title": "EMQX 报文收发速率",
      "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 30 },
      "targets": [
        { "refId": "A", "expr": "rate(emqx_packets_received[$__rate_interval])", "editorMode": "code", "legendFormat": "recv" },
        { "refId": "B", "expr": "rate(emqx_packets_sent[$__rate_interval])", "editorMode": "code", "legendFormat": "sent" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "pps", "custom": { "drawStyle": "line", "fillOpacity": 10 } },
        "overrides": []
      }
    },
    {
      "id": 111,
      "type": "timeseries",
      "title": "EMQX 消息积压趋势",
      "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 38 },
      "targets": [
        { "refId": "A", "expr": "delta(emqx_metrics_messages_received[$__rate_interval]) - delta(emqx_metrics_messages_delivered[$__rate_interval])", "editorMode": "code", "legendFormat": "net-backlog" },
        { "refId": "B", "expr": "emqx_subscriptions_count", "editorMode": "code", "legendFormat": "subscriptions" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10 } },
        "overrides": []
      }
    }
  ]
}